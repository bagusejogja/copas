generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Unit {
  id             Int            @id @default(autoincrement())
  nama_unit      String
  parent_unit_id Int?
  parent_unit    Unit?          @relation("UnitHierarchy", fields: [parent_unit_id], references: [id])
  child_units    Unit[]         @relation("UnitHierarchy")
  users          User[]
  proposals      Proposal[]
  programKerjas  ProgramKerja[]
  expenseRefs    ExpenseReference[]
  activityTypes  ActivityType[]
  accounts       Account[]
  paguRecords    UnitPagu[]
}

model Role {
  id           Int           @id @default(autoincrement())
  nama_jabatan String
  level        Int
  is_active    Boolean       @default(true)
  users        User[]
  permissions  Permission[]
  approvalFlows ApprovalFlow[]
}

model User {
  id       Int       @id @default(autoincrement())
  username String    @unique
  password String
  nama     String
  unit_id  Int
  unit     Unit      @relation(fields: [unit_id], references: [id])
  role_id  Int
  role     Role      @relation(fields: [role_id], references: [id])
  proposals     Proposal[]    @relation("Pemohon")
  proposalsPaid Proposal[]    @relation("Bendahara")
  approvals     Approval[]
  prokerDibuat  ProgramKerja[] @relation("ProkerPembuat")
}

model Menu {
  id          Int          @id @default(autoincrement())
  nama_menu   String
  path        String       @unique
  permissions Permission[]
}

model Permission {
  id         Int     @id @default(autoincrement())
  role_id    Int
  role       Role    @relation(fields: [role_id], references: [id])
  menu_id    Int
  menu       Menu    @relation(fields: [menu_id], references: [id])
  can_create Boolean @default(false)
  can_read   Boolean @default(false)
  can_update Boolean @default(false)
  can_delete Boolean @default(false)

  @@unique([role_id, menu_id])
}

model ExpenseReference {
  id          Int              @id @default(autoincrement())
  nama        String
  unit_id     Int?             // Opsional, jika null berarti global
  unit        Unit?            @relation(fields: [unit_id], references: [id])
  is_active   Boolean          @default(true)
  details     ProposalDetail[]
}

model ActivityType {
  id          Int        @id @default(autoincrement())
  nama        String
  unit_id     Int?
  unit        Unit?      @relation(fields: [unit_id], references: [id])
  is_active   Boolean    @default(true)
  proposals   Proposal[]
}

model Account {
  id          Int              @id @default(autoincrement())
  nomor       String         
  nama_akun   String
  unit_id     Int?
  unit        Unit?            @relation(fields: [unit_id], references: [id])
  is_active   Boolean          @default(true)
  details     ProposalDetail[]
  pjDetails   PertanggungjawabanDetail[]
}

model Proposal {
  id               Int              @id @default(autoincrement())
  unit_id          Int
  unit             Unit             @relation(fields: [unit_id], references: [id])
  pemohon_id       Int
  pemohon          User             @relation("Pemohon", fields: [pemohon_id], references: [id])
  tanggal          DateTime         @default(now())
  judul            String
  activity_type_id Int
  activity_type    ActivityType     @relation(fields: [activity_type_id], references: [id])
  status_terakhir  String           @default("PENDING")
  proker_id        Int?             
  proker           ProgramKerja?    @relation(fields: [proker_id], references: [id])
  
  // Payment Info
  tanggal_bayar    DateTime?
  dibayar_oleh_id  Int?
  dibayar_oleh     User?            @relation("Bendahara", fields: [dibayar_oleh_id], references: [id])
  
  latar_belakang   String?          @db.Text
  tujuan           String?          @db.Text
  bentuk_kegiatan  String?          @db.Text
  jumlah_peserta   Int?
  kerjasama        String?
  peralatan        String?          @db.Text
  tanggal_mulai    DateTime?
  tanggal_selesai  DateTime?
  tempat           String?          @db.Text
  susunan_panitia  String?          @db.Text
  file_dokumen     String?
  
  details          ProposalDetail[]
  approvals        Approval[]
  pertanggungjawabans Pertanggungjawaban[]
  kasRecords       Kas[]

  @@index([status_terakhir])
  @@index([unit_id])
  @@index([pemohon_id])
}

model Kas {
  id               Int      @id @default(autoincrement())
  tanggal          DateTime @default(now())
  proposal_id      Int?     
  proposal         Proposal? @relation(fields: [proposal_id], references: [id])
  tipe             String   // "MASUK" atau "KELUAR"
  kategori         String?  // Usulan Anggaran, Manual, Hibah, dll
  deskripsi        String
  nominal          Decimal  @db.Decimal(15, 2)
  unit_id          Int?

  @@index([unit_id])
  @@index([tanggal])
}

model Pertanggungjawaban {
  id               Int      @id @default(autoincrement())
  proposal_id      Int      @unique
  proposal         Proposal @relation(fields: [proposal_id], references: [id], onDelete: Cascade)
  tanggal_laporan  DateTime @default(now())
  ringkasan        String   @db.Text
  total_realisasi  Decimal  @db.Decimal(15,2)
  file_laporan     String?
  status           String   @default("SUBMITTED") // DRAFT, SUBMITTED
  
  // Penandatangan
  nama_pembuat     String?
  nama_bendahara   String?
  nama_pimpinan    String?
  
  // Data Keuangan Sisa
  total_diterima   Decimal  @db.Decimal(15,2) @default(0) // Dana yang cair di awal
  sisa_dana        Decimal  @db.Decimal(15,2) @default(0) // total_diterima - total_realisasi
  opsi_sisa        String   @default("KEMBALI") // KEMBALI, LANJUT
  
  details          PertanggungjawabanDetail[]

  @@index([status])
  @@index([proposal_id])
}

model PertanggungjawabanDetail {
  id                   Int                @id @default(autoincrement())
  pj_id                Int
  pj                   Pertanggungjawaban @relation(fields: [pj_id], references: [id], onDelete: Cascade)
  account_id           Int
  account              Account            @relation(fields: [account_id], references: [id])
  keterangan           String             // Detail per item nota
  nominal              Decimal            @db.Decimal(15, 2)
}

model ProposalDetail {
  id                   Int              @id @default(autoincrement())
  proposal_id          Int
  proposal             Proposal         @relation(fields: [proposal_id], references: [id], onDelete: Cascade)
  expense_reference_id Int
  expense_reference    ExpenseReference @relation(fields: [expense_reference_id], references: [id])
  account_id           Int
  account              Account          @relation(fields: [account_id], references: [id])
  deskripsi            String
  nominal              Decimal          @db.Decimal(15, 2)
}

model Approval {
  id             Int      @id @default(autoincrement())
  proposal_id    Int
  proposal       Proposal @relation(fields: [proposal_id], references: [id], onDelete: Cascade)
  approver_id    Int
  approver       User     @relation(fields: [approver_id], references: [id])
  status         String   // APPROVED, REJECTED
  catatan        String?
  tanggal        DateTime @default(now())
  level_approval Int      // 1 = Atasan, 2 = Pimpinan
}

// Konfigurasi alur approval yang bisa diset custom oleh admin
model ApprovalFlow {
  id          Int    @id @default(autoincrement())
  urutan      Int
  role_id     Int
  role        Role   @relation(fields: [role_id], references: [id])
  label       String
  is_active   Boolean @default(true)
}

// Program Kerja Tahunan
model ProgramKerja {
  id                   Int       @id @default(autoincrement())
  unit_id              Int
  unit                 Unit      @relation(fields: [unit_id], references: [id])
  periode_tahun        Int       // Contoh: 2026
  nama_kegiatan        String    // Pilih dari master data referensi
  sifat_kegiatan       String    // "Pokok" atau "Bantu"
  uraian_kegiatan      String?   @db.Text
  lembaga_mitra        String?
  sasaran              String?   @db.Text
  tujuan               String?   @db.Text
  strategi             String?   @db.Text
  indikator            String?   @db.Text
  anggaran_setahun     Decimal   @db.Decimal(15, 2)
  tanggal_mulai        DateTime?
  tanggal_selesai      DateTime?
  is_active            Boolean   @default(true)
  dibuat_oleh_id       Int
  dibuat_oleh          User      @relation("ProkerPembuat", fields: [dibuat_oleh_id], references: [id])
  proposals            Proposal[]
  createdAt            DateTime  @default(now())
}

model UnitPagu {
  id        Int      @id @default(autoincrement())
  unit_id   Int
  unit      Unit     @relation(fields: [unit_id], references: [id])
  tahun     Int
  nominal   Decimal  @db.Decimal(15, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([unit_id, tahun])
}

model GlobalSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

